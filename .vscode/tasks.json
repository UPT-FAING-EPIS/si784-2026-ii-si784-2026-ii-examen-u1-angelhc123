{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: run",
      "type": "shell",
      "command": "dotnet run --launch-profile http",
      "options": { "cwd": "${workspaceFolder}/backend/TorneoApi" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend: test",
      "type": "shell",
      "command": "dotnet test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Levantar todo",
      "dependsOn": ["Backend: run", "Frontend: dev"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
